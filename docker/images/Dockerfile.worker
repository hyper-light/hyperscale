# syntax=docker/dockerfile:1.7
#
# Hyperscale Worker image.
#
# Builds a reproducible runtime image for the AD-52 §12 "worker" role.
# Workers execute load-test workloads and emit results. By default the
# image ships with no workload-client extras — HTTP/1.1 is in core;
# anything else (grpc, gql, http3, sql, kafka, mongodb, redis, playwright,
# etc.) is added by the operator either at image build time via
# HYPERSCALE_EXTRAS or via FROM-extension at runtime.
#
# JSON and CSV result reporting are built into hyperscale; the default
# result path is forwarding back to the client through gates. External
# reporters (datadog, prometheus, statsd, snowflake, …) are likewise
# opt-in extras.
#
# Build (from repository root, default — no extras):
#   docker build -f docker/images/Dockerfile.worker \
#       --build-arg HYPERSCALE_VERSION=$(grep -m1 version pyproject.toml | cut -d'"' -f2) \
#       --build-arg VCS_REF=$(git rev-parse --short HEAD) \
#       --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#       -t hyperscale/worker:<version> .
#
# Build with a specific workload extras set:
#   docker build -f docker/images/Dockerfile.worker \
#       --build-arg HYPERSCALE_EXTRAS=grpc,graphql,http3 \
#       -t hyperscale/worker:<version>-grpc .
#
# Extend at runtime:
#   FROM hyperscale/worker:<version>
#   USER root
#   RUN apt-get update && apt-get install -y --no-install-recommends \
#           libpq5 \
#       && rm -rf /var/lib/apt/lists/*
#   USER hyperscale
#   RUN /opt/hyperscale/.venv/bin/uv pip install --no-deps psycopg2-binary asyncpg
#
# HYPERSCALE_EXTRAS accepts a comma-separated list of names from the
# pyproject.toml [project.optional-dependencies] table — e.g. "grpc",
# "graphql", "http3", "kafka", "sql", "mongodb", "redis", "cassandra",
# "playwright", "ssh", "snowflake", "aws", "google", "azure", "xml",
# "honeycomb", "influxdb", "newrelic", "statsd", "prometheus", "datadog",
# "opentelemetry", "har".

ARG PYTHON_VERSION=3.13
ARG DEBIAN_RELEASE=bookworm

FROM python:${PYTHON_VERSION}-slim-${DEBIAN_RELEASE} AS builder

ARG HYPERSCALE_EXTRAS=""

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/build/.venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# Workers may need broader system libs than control-plane nodes because
# operator-chosen extras pull in clients that link to C libraries (postgres,
# mysql, snowflake, etc.). Build deps are still purged from the runtime
# stage — only execution-time .so dependencies are kept.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

WORKDIR /build

COPY pyproject.toml uv.lock README.md MANIFEST.in LICENSE ./

# Lockfile-pinned dep layer. Conditional extras: empty arg → no extras.
RUN set -eux; \
    extra_args=""; \
    if [ -n "${HYPERSCALE_EXTRAS}" ]; then \
        for extra in $(echo "${HYPERSCALE_EXTRAS}" | tr ',' ' '); do \
            extra_args="${extra_args} --extra ${extra}"; \
        done; \
    fi; \
    uv sync --frozen --no-dev --no-install-project ${extra_args}

COPY hyperscale ./hyperscale

RUN set -eux; \
    extra_args=""; \
    if [ -n "${HYPERSCALE_EXTRAS}" ]; then \
        for extra in $(echo "${HYPERSCALE_EXTRAS}" | tr ',' ' '); do \
            extra_args="${extra_args} --extra ${extra}"; \
        done; \
    fi; \
    uv sync --frozen --no-dev ${extra_args}

# Keep uv available inside the venv so user extensions can `uv pip install`
# without re-downloading uv from scratch in their FROM layer.
RUN /build/.venv/bin/python -m pip install --no-cache-dir uv

FROM python:${PYTHON_VERSION}-slim-${DEBIAN_RELEASE} AS runtime

ARG HYPERSCALE_VERSION=unknown
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG HYPERSCALE_EXTRAS=""

LABEL org.opencontainers.image.title="hyperscale-worker" \
      org.opencontainers.image.description="Hyperscale worker node — AD-52 §12 data plane. Designed to be FROM-extended for custom workload clients and reporters." \
      org.opencontainers.image.source="https://github.com/hyper-light/hyperscale" \
      org.opencontainers.image.version="${HYPERSCALE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      io.hyperscale.role="worker" \
      io.hyperscale.ad="AD-52" \
      io.hyperscale.extras="${HYPERSCALE_EXTRAS}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/hyperscale/.venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 hyperscale \
    && useradd --system --uid 65532 --gid 65532 \
        --home-dir /opt/hyperscale --shell /bin/sh hyperscale \
    && mkdir -p /opt/hyperscale /var/lib/hyperscale /etc/hyperscale \
    && chown -R hyperscale:hyperscale /opt/hyperscale /var/lib/hyperscale /etc/hyperscale

COPY --from=builder --chown=hyperscale:hyperscale /build/.venv /opt/hyperscale/.venv

USER hyperscale:hyperscale
WORKDIR /opt/hyperscale

EXPOSE 8080/tcp 8081/udp 9090/tcp

ENTRYPOINT ["/opt/hyperscale/.venv/bin/hyperscale", "serve", "--role", "worker"]
