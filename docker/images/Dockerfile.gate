# syntax=docker/dockerfile:1.7
#
# Hyperscale Gate image.
#
# Builds a reproducible runtime image for the AD-52 §21 "gate" role from
# local source — never from PyPI. The image bakes --role gate into the
# entrypoint so misconfiguration (gate image launched with --role manager)
# is impossible. Gates carry only the cluster + self-observability code
# path; no workload-client extras, no result-reporter database drivers.
#
# Build (from repository root):
#   docker build -f docker/images/Dockerfile.gate \
#       --build-arg HYPERSCALE_VERSION=$(grep -m1 version pyproject.toml | cut -d'"' -f2) \
#       --build-arg VCS_REF=$(git rev-parse --short HEAD) \
#       --build-arg BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
#       -t hyperscale/gate:<version> .
#
# Run (typically via Helm — see helm/hyperscale-gate):
#   docker run --rm hyperscale/gate \
#       --cluster-id prod-uswest-gates \
#       --listen-address 0.0.0.0:8080 \
#       --mtls-cert /etc/hyperscale/tls/tls.crt \
#       --mtls-key /etc/hyperscale/tls/tls.key \
#       --mtls-ca /etc/hyperscale/tls/ca.crt \
#       --initial-members gate-0@dns://gate-0.gates.svc:8080,...

ARG PYTHON_VERSION=3.13
ARG DEBIAN_RELEASE=bookworm

# ---------------------------------------------------------------------------
# Builder stage: produces /build/.venv with hyperscale + locked deps only.
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_RELEASE} AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/build/.venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# Build deps. Removed in the runtime stage; nothing leaks forward.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

WORKDIR /build

# Lockfile-pinned dep layer (cacheable across source changes).
COPY pyproject.toml uv.lock README.md MANIFEST.in LICENSE ./

RUN uv sync --frozen --no-dev --no-install-project

# Source layer.
COPY hyperscale ./hyperscale

# Install the project itself without re-resolving deps (already locked above).
RUN uv sync --frozen --no-dev

# ---------------------------------------------------------------------------
# Runtime stage: minimal slim image. No build toolchain, no curl, no apt
# caches. Non-root user. The Python process owns PID 1; signal handlers
# are installed by hyperscale/commands/serve.py.
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_RELEASE} AS runtime

ARG HYPERSCALE_VERSION=unknown
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="hyperscale-gate" \
      org.opencontainers.image.description="Hyperscale gate node — AD-52 cluster control plane (global Raft)." \
      org.opencontainers.image.source="https://github.com/hyper-light/hyperscale" \
      org.opencontainers.image.version="${HYPERSCALE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      io.hyperscale.role="gate" \
      io.hyperscale.ad="AD-52"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/hyperscale/.venv/bin:${PATH}"

# Only the runtime libs hyperscale needs at execution time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 hyperscale \
    && useradd --system --uid 65532 --gid 65532 \
        --home-dir /opt/hyperscale --shell /usr/sbin/nologin hyperscale \
    && mkdir -p /opt/hyperscale /var/lib/hyperscale /etc/hyperscale \
    && chown -R hyperscale:hyperscale /opt/hyperscale /var/lib/hyperscale /etc/hyperscale

COPY --from=builder --chown=hyperscale:hyperscale /build/.venv /opt/hyperscale/.venv

USER hyperscale:hyperscale
WORKDIR /opt/hyperscale

# Default cluster TCP + legacy SWIM UDP + AD-52 §18 metrics surface.
# Actual ports are set by --listen-address; EXPOSE here is documentary.
EXPOSE 8080/tcp 8081/udp 9090/tcp

ENTRYPOINT ["/opt/hyperscale/.venv/bin/hyperscale", "serve", "--role", "gate"]
